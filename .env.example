# =============================================================================
# GlobalTalk AI Environment Configuration
# =============================================================================
# IMPORTANT:
# - Do NOT commit .env to version control.
# - GEMINI_API_KEY is secret and must remain strictly server-side.
# - Never prefix GEMINI_API_KEY with VITE_.
# =============================================================================

# Server Settings (Required for Gemini Live API Token Creation)
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8787
NODE_ENV=development

# Optional: Allowed origins for CORS in production (comma-separated if multiple)
# CLIENT_URL=https://your-domain.com

# Optional: Custom API base URL if frontend and backend are hosted on separate domains
# VITE_API_URL=

# Optional: Firebase Web Configuration for Google Sign-In and Cloud Session History
# If omitted or left blank, GlobalTalk AI runs in offline/local storage mode automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
